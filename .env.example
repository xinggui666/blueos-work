# BlueOS 工坊环境变量模板。复制为 .env 后填写；.env 不要提交。

# ── 服务监听 ──────────────────────────────
# 应用监听端口（开发 `npm run dev` 和生产 `node .output/server/index.mjs` 都读它）
PORT=8080
# 监听地址。容器内用 0.0.0.0；直接跑在主机上且前面有 Nginx 时用 127.0.0.1
HOST=0.0.0.0
# vite preview 端口（只在本地预览构建产物时用）
PREVIEW_PORT=8081
# 构建产物格式：node-server（自有服务器/Docker）或 vercel
NITRO_PRESET=node-server

# ── 数据库（生产必填）──────────────────────
# 不填时退回内存 PGLite，重启丢数据，只能用于本地试用
DATABASE_URL=postgres://blueos:CHANGE_ME@127.0.0.1:5432/blueos
# 本地不用 Postgres 又想保留数据时，可以让 PGLite 落盘（生产不要用）
# PGLITE_DATA_DIR=./.data/pglite

# docker-compose 用
POSTGRES_USER=blueos
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=blueos
# 宿主机绑定地址与端口（默认只绑本机，由 Nginx 对外提供 HTTPS）
BIND_ADDR=127.0.0.1
PUBLIC_PORT=8080

# ── 登录（生产必填）────────────────────────
# 只有这个邮箱注册后会成为首个超级管理员（生产强烈建议设置）
BOOTSTRAP_ADMIN_EMAIL=
# 会话签名密钥，至少 32 字节随机值：openssl rand -hex 32
BETTER_AUTH_SECRET=
# 对外访问地址（https），用于回调与来源校验
BETTER_AUTH_URL=https://workshop.example.com
# 设为 false 会关闭登录（只在没有数据库的本地演示里用）
VITE_AUTH_ENABLED=true
# 第三方登录 broker（不用 Google/X 登录可以不填）
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
