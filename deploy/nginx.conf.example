server {
  listen 80;
  server_name workshop.example.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  server_name workshop.example.com;
  # ssl_certificate /etc/letsencrypt/live/workshop.example.com/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/workshop.example.com/privkey.pem;

  # Binary PNG / bproj JSON-base64 transport. App still caps ordinary API actions at 1MB.
  # Bind the upstream privately; do not expose port 8080 directly to the Internet.
  client_max_body_size 16m;

  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}
